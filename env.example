# ============================================================
# Docker Compose 환경변수
# 위치: ~/ticketing/.env (VM 안)
# 권한: chmod 600 .env (보안)
# ============================================================

# Oracle XE 비밀번호 (SYS, SYSTEM 공통)
# Oracle 21c 비밀번호 정책:
#   - 최소 8자
#   - 대문자, 소문자, 숫자, 특수문자 포함
ORACLE_PWD=TicketDev2026!

# Splunk Admin 비밀번호
SPLUNK_PWD=SplunkAdmin2026!

# 내부망 Splunk Indexer IP:포트
# 실제 VMware 환경의 mgmt-splunk VM IP로 수정
SPLUNK_INDEXER=192.168.20.10:9997
