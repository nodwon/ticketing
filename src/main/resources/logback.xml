<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================
  Project   : 티켓팅 보안관제 (Ticketing Security Monitoring)
  File      : logback.xml
  Location  : src/main/resources/logback.xml

  파일명 규칙 (일별 분리):
    - 오늘:   log_auth.json
    - 어제:   log_auth.2026-05-26.json.gz
  ============================================================
-->
<configuration scan="true" scanPeriod="60 seconds">

  <property name="LOG_HOME" value="${LOG_HOME:-C:/logs/ticketing/security}"/>

  <!-- 1) 콘솔 -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <!-- 2) 일반 애플리케이션 로그 (일별 롤링) -->
  <appender name="FILE_APP" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_HOME}/application.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_HOME}/application.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
      <maxHistory>14</maxHistory>
      <totalSizeCap>5GB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <!-- 3) SQL 로그 (일별 롤링) -->
  <appender name="FILE_SQL" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_HOME}/sql.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_HOME}/sql.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
      <maxHistory>7</maxHistory>
      <totalSizeCap>5GB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{40} - %msg%n</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <!-- ============================================================
       4) [보안 로그] log_auth
       ============================================================ -->
  <appender name="FILE_AUTH" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_HOME}/log_auth.json</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_HOME}/log_auth.%d{yyyy-MM-dd}.json.gz</fileNamePattern>
      <maxHistory>30</maxHistory>
      <totalSizeCap>10GB</totalSizeCap>
    </rollingPolicy>
    <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
      <providers>
        <timestamp>
          <fieldName>event_time</fieldName>
          <pattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</pattern>
        </timestamp>
        <pattern>
          <pattern>{"log_type":"log_auth"}</pattern>
        </pattern>
        <mdc/>
        <arguments/>
        <logstashMarkers/>
        <message><fieldName>message</fieldName></message>
      </providers>
    </encoder>
  </appender>

  <!-- 5) [보안 로그] log_seat -->
  <appender name="FILE_SEAT" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_HOME}/log_seat.json</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_HOME}/log_seat.%d{yyyy-MM-dd}.json.gz</fileNamePattern>
      <maxHistory>30</maxHistory>
      <totalSizeCap>10GB</totalSizeCap>
    </rollingPolicy>
    <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
      <providers>
        <timestamp>
          <fieldName>event_time</fieldName>
          <pattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</pattern>
        </timestamp>
        <pattern>
          <pattern>{"log_type":"log_seat"}</pattern>
        </pattern>
        <mdc/>
        <arguments/>
        <logstashMarkers/>
        <message><fieldName>message</fieldName></message>
      </providers>
    </encoder>
  </appender>

  <!-- 6) [보안 로그] log_payment (90일 보관) -->
  <appender name="FILE_PAYMENT" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_HOME}/log_payment.json</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_HOME}/log_payment.%d{yyyy-MM-dd}.json.gz</fileNamePattern>
      <maxHistory>90</maxHistory>
      <totalSizeCap>20GB</totalSizeCap>
    </rollingPolicy>
    <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
      <providers>
        <timestamp>
          <fieldName>event_time</fieldName>
          <pattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</pattern>
        </timestamp>
        <pattern>
          <pattern>{"log_type":"log_payment"}</pattern>
        </pattern>
        <mdc/>
        <arguments/>
        <logstashMarkers/>
        <message><fieldName>message</fieldName></message>
      </providers>
    </encoder>
  </appender>

  <!-- 7) [보안 로그] log_admin_access (180일 보관) -->
  <appender name="FILE_ADMIN" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_HOME}/log_admin_access.json</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_HOME}/log_admin_access.%d{yyyy-MM-dd}.json.gz</fileNamePattern>
      <maxHistory>180</maxHistory>
      <totalSizeCap>10GB</totalSizeCap>
    </rollingPolicy>
    <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
      <providers>
        <timestamp>
          <fieldName>event_time</fieldName>
          <pattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</pattern>
        </timestamp>
        <pattern>
          <pattern>{"log_type":"log_admin_access"}</pattern>
        </pattern>
        <mdc/>
        <arguments/>
        <logstashMarkers/>
        <message><fieldName>message</fieldName></message>
      </providers>
    </encoder>
  </appender>

  <!-- 8) [보안 로그] log_board -->
  <appender name="FILE_BOARD" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_HOME}/log_board.json</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_HOME}/log_board.%d{yyyy-MM-dd}.json.gz</fileNamePattern>
      <maxHistory>30</maxHistory>
      <totalSizeCap>10GB</totalSizeCap>
    </rollingPolicy>
    <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
      <providers>
        <timestamp>
          <fieldName>event_time</fieldName>
          <pattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</pattern>
        </timestamp>
        <pattern>
          <pattern>{"log_type":"log_board"}</pattern>
        </pattern>
        <mdc/>
        <arguments/>
        <logstashMarkers/>
        <message><fieldName>message</fieldName></message>
      </providers>
    </encoder>
  </appender>

  <!-- 9) [보안 로그] log_behavior_feature -->
  <appender name="FILE_BEHAVIOR" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_HOME}/log_behavior_feature.json</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_HOME}/log_behavior_feature.%d{yyyy-MM-dd}.json.gz</fileNamePattern>
      <maxHistory>30</maxHistory>
      <totalSizeCap>10GB</totalSizeCap>
    </rollingPolicy>
    <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
      <providers>
        <timestamp>
          <fieldName>event_time</fieldName>
          <pattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</pattern>
        </timestamp>
        <pattern>
          <pattern>{"log_type":"log_behavior_feature"}</pattern>
        </pattern>
        <mdc/>
        <arguments/>
        <logstashMarkers/>
        <message><fieldName>message</fieldName></message>
      </providers>
    </encoder>
  </appender>

  <!-- 비동기 래퍼 -->
  <appender name="ASYNC_AUTH" class="ch.qos.logback.classic.AsyncAppender">
    <appender-ref ref="FILE_AUTH"/>
    <queueSize>5000</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <neverBlock>false</neverBlock>
  </appender>

  <appender name="ASYNC_SEAT" class="ch.qos.logback.classic.AsyncAppender">
    <appender-ref ref="FILE_SEAT"/>
    <queueSize>20000</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <neverBlock>false</neverBlock>
  </appender>

  <appender name="ASYNC_PAYMENT" class="ch.qos.logback.classic.AsyncAppender">
    <appender-ref ref="FILE_PAYMENT"/>
    <queueSize>10000</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <neverBlock>false</neverBlock>
  </appender>

  <appender name="ASYNC_ADMIN" class="ch.qos.logback.classic.AsyncAppender">
    <appender-ref ref="FILE_ADMIN"/>
    <queueSize>5000</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <neverBlock>false</neverBlock>
  </appender>

  <appender name="ASYNC_BOARD" class="ch.qos.logback.classic.AsyncAppender">
    <appender-ref ref="FILE_BOARD"/>
    <queueSize>5000</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <neverBlock>false</neverBlock>
  </appender>

  <appender name="ASYNC_BEHAVIOR" class="ch.qos.logback.classic.AsyncAppender">
    <appender-ref ref="FILE_BEHAVIOR"/>
    <queueSize>30000</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <neverBlock>false</neverBlock>
  </appender>

  <!-- 보안 로거 매핑 -->
  <logger name="SECURITY.AUTH"     level="INFO" additivity="false">
    <appender-ref ref="ASYNC_AUTH"/>
  </logger>
  <logger name="SECURITY.SEAT"     level="INFO" additivity="false">
    <appender-ref ref="ASYNC_SEAT"/>
  </logger>
  <logger name="SECURITY.PAYMENT"  level="INFO" additivity="false">
    <appender-ref ref="ASYNC_PAYMENT"/>
  </logger>
  <logger name="SECURITY.ADMIN"    level="INFO" additivity="false">
    <appender-ref ref="ASYNC_ADMIN"/>
  </logger>
  <logger name="SECURITY.BOARD"    level="INFO" additivity="false">
    <appender-ref ref="ASYNC_BOARD"/>
  </logger>
  <logger name="SECURITY.BEHAVIOR" level="INFO" additivity="false">
    <appender-ref ref="ASYNC_BEHAVIOR"/>
  </logger>

  <!-- 애플리케이션 로거 -->
  <logger name="stu" level="DEBUG" additivity="false">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE_APP"/>
  </logger>

  <!-- MyBatis SQL 로깅 -->
  <logger name="org.mybatis"                       level="DEBUG" additivity="false">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE_SQL"/>
  </logger>
  <logger name="java.sql.Connection"               level="WARN"  additivity="false">
    <appender-ref ref="FILE_SQL"/>
  </logger>
  <logger name="java.sql.PreparedStatement"        level="DEBUG" additivity="false">
    <appender-ref ref="FILE_SQL"/>
  </logger>
  <logger name="java.sql.Statement"                level="DEBUG" additivity="false">
    <appender-ref ref="FILE_SQL"/>
  </logger>
  <logger name="java.sql.ResultSet"                level="WARN"  additivity="false">
    <appender-ref ref="FILE_SQL"/>
  </logger>

  <!-- 프레임워크 로거 -->
  <logger name="org.springframework"      level="INFO"/>
  <logger name="org.springframework.web"  level="INFO"/>
  <logger name="org.apache.tiles"         level="WARN"/>
  <logger name="org.apache.commons"       level="WARN"/>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE_APP"/>
  </root>

</configuration>
