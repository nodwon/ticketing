<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
* ============================================================
* Project    : 관제 티켓 (Ticketing System)
* Package    : mapper.my (namespace="my")
* FileName   : my_SQL.xml
*
* Developer  : 김희재 (feature/khj)
* Created    : 2026.05.24
* Modified   : 2026.05.24
*
* Description :
*   - 마이페이지 MyBatis 매퍼 (Oracle 21c)
*   - 회원정보 조회/수정, 회원 탈퇴, 예매 내역 조회
*
* Tables     : members, bookings, concert_schedules, concerts
* ============================================================
-->
<mapper namespace="my">

    <!-- ============================================================ -->
    <!-- 1. 회원정보 조회                                                -->
    <!-- ============================================================ -->
    <select id="selectMemberInfo" parameterType="hashmap" resultType="hashmap">
        SELECT
            member_id      AS MEMBER_ID
          , email          AS EMAIL
          , name           AS NAME
          , phone          AS PHONE
          , TO_CHAR(birth_date, 'YYYY-MM-DD') AS BIRTH_DATE
          , role           AS ROLE
        FROM members
        WHERE member_id = #{MEMBER_ID}
    </select>


    <!-- ============================================================ -->
    <!-- 2. 회원정보 수정                                                -->
    <!--    이름 / 휴대폰 / 생년월일만 수정 가능                            -->
    <!--    (이메일/비번/role 은 별도 메뉴에서 — 권한 상승 방지)            -->
    <!-- ============================================================ -->
    <update id="updateMemberInfo" parameterType="hashmap">
        UPDATE members
        SET
            name        = #{NAME}
          , phone       = #{PHONE}
          , birth_date  = TO_DATE(#{BIRTH_DATE}, 'YYYYMMDD')
        WHERE member_id = #{MEMBER_ID}
    </update>


    <!-- ============================================================ -->
    <!-- 3. 회원 탈퇴 (물리 삭제)                                         -->
    <!-- ============================================================ -->
    <delete id="deleteMember" parameterType="hashmap">
        DELETE FROM members
        WHERE member_id = #{MEMBER_ID}
    </delete>


    <!-- ============================================================ -->
    <!-- 4. 예매 내역 조회                                                -->
    <!--    bookings × concert_schedules × concerts                     -->
    <!-- ============================================================ -->
    <select id="selectBookingList" parameterType="hashmap" resultType="hashmap">
        SELECT
            B.booking_id          AS BOOKING_ID
          , B.total_price         AS TOTAL_PRICE
          , B.status              AS BOOKING_STATUS
          , TO_CHAR(B.created_at, 'YYYY-MM-DD HH24:MI') AS CREATED_AT
          , C.title               AS CONCERT_TITLE
          , C.artist              AS ARTIST
          , C.venue               AS VENUE
          , C.thumbnail           AS THUMBNAIL
          , TO_CHAR(S.performance_date, 'YYYY-MM-DD HH24:MI') AS PERFORMANCE_DATE
        FROM bookings B
        INNER JOIN concert_schedules S ON B.schedule_id = S.schedule_id
        INNER JOIN concerts          C ON S.concert_id  = C.concert_id
        WHERE B.member_id = #{MEMBER_ID}
        ORDER BY B.created_at DESC
    </select>

	<!-- ============================================================ -->
    <!-- 5. 활성 예매 건수 조회 (회원 탈퇴 차단용)                          -->
    <!--    PENDING / CONFIRMED 만 카운트 (CANCELLED 제외)              -->
    <!-- ============================================================ -->
    <select id="countActiveBookings" parameterType="hashmap" resultType="int">
        SELECT COUNT(*)
        FROM bookings
        WHERE member_id = #{MEMBER_ID}
          AND status IN ('PENDING', 'CONFIRMED')
    </select>
    
</mapper>
