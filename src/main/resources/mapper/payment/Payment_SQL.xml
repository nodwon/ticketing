<?xml version="1.0" encoding="UTF-8"?>
<!--
    ============================================================
    Project    : 관제 티켓 (Ticketing System)
    Package    : payment (MyBatis Mapper)
    FileName   : Payment_SQL.xml

    Developer  : <본인 이름> (feature/king)
    Created    : 2026.05.22
    Modified   : 2026.05.26

    Description :
      payments / log_payment 테이블 MyBatis 매퍼 (API 명세서 반영).
        - payments.payment_id : GENERATED AS IDENTITY (useGeneratedKeys)
        - log_payment 테이블 INSERT 추가
        - confirm (PG 콜백) / refund (환불) 상태 전이 쿼리 추가
        - 모든 동적 값은 #{} 바인딩 (PreparedStatement)
    ============================================================
-->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="Payment">

    <!-- ============================================================ -->
    <!-- 1) 결제 요청 INSERT (PENDING)                                  -->
    <!--    POST /api/payments                                          -->
    <!-- ============================================================ -->
    <insert id="insertPayment" parameterType="stu.payment.PaymentVO"
            useGeneratedKeys="true" keyProperty="paymentId" keyColumn="PAYMENT_ID">
        INSERT INTO payments (
            booking_id,
            member_id,
            transaction_id,
            requested_amount,
            status
        ) VALUES (
            #{bookingId},
            #{memberId},
            #{transactionId},
            #{requestedAmount},
            'PENDING'
        )
    </insert>

    <!-- ============================================================ -->
    <!-- 2) 결제 완료 처리 (PG 콜백)                                    -->
    <!--    POST /api/payments/{id}/confirm                              -->
    <!--    transaction_id 기준으로 payments.status UPDATE              -->
    <!-- ============================================================ -->
    <update id="confirmPayment" parameterType="map">
        UPDATE payments
           SET status = #{status}
         WHERE transaction_id = #{transactionId}
    </update>

    <!-- ============================================================ -->
    <!-- 3) 환불 처리                                                   -->
    <!--    POST /api/payments/{id}/refund                              -->
    <!-- ============================================================ -->
    <update id="refundPayment" parameterType="string">
        UPDATE payments
           SET status = 'REFUNDED'
         WHERE transaction_id = #{transactionId}
           AND status = 'SUCCESS'
    </update>

    <!-- ============================================================ -->
    <!-- 4) 결제 내역 단건 조회                                         -->
    <!--    GET /api/payments/{id}                                       -->
    <!-- ============================================================ -->
    <select id="selectByTxId" parameterType="string"
            resultType="java.util.HashMap">
        SELECT payment_id,
               booking_id,
               member_id,
               transaction_id,
               requested_amount,
               status
          FROM payments
         WHERE transaction_id = #{transactionId}
    </select>

    <!-- ============================================================ -->
    <!-- 5) 회원별 결제 내역                                            -->
    <!-- ============================================================ -->
    <select id="selectHistoryByMember" parameterType="long"
            resultType="java.util.HashMap">
        SELECT payment_id,
               booking_id,
               member_id,
               transaction_id,
               requested_amount,
               status
          FROM payments
         WHERE member_id = #{memberId}
         ORDER BY payment_id DESC
    </select>

    <!-- ============================================================ -->
    <!-- 6) 결제 폼 표시용 — booking + schedule + concert JOIN          -->
    <!--    화면용 — REST 명세에는 없지만 JSP 진입을 위해 유지          -->
    <!-- ============================================================ -->
    <select id="selectBookingForPayment" parameterType="long"
            resultType="java.util.HashMap">
        SELECT b.booking_id      AS bookingId,
               b.member_id        AS memberId,
               b.schedule_id      AS scheduleId,
               b.total_price      AS totalPrice,
               b.status           AS bookingStatus,
               s.performance_date AS performanceDate,
               c.concert_id       AS concertId,
               c.title            AS concertTitle,
               c.artist           AS artist,
               c.venue            AS venue
          FROM bookings           b
          JOIN concert_schedules  s ON s.schedule_id = b.schedule_id
          JOIN concerts           c ON c.concert_id  = s.concert_id
         WHERE b.booking_id = #{bookingId}
    </select>

    <!-- ============================================================ -->
    <!-- 7) log_payment INSERT (감사/관제 로그)                          -->
    <!--    POST /internal/log/payment 와 동일한 데이터                  -->
    <!--    log_timestamp 은 DB default SYSTIMESTAMP                     -->
    <!-- ============================================================ -->
    <insert id="insertLogPayment" parameterType="stu.payment.LogPaymentVO"
            useGeneratedKeys="true" keyProperty="logId" keyColumn="LOG_ID">
        INSERT INTO log_payment (
            user_id,
            transaction_id,
            payment_amount,
            actual_price,
            payment_result
        ) VALUES (
            #{userId},
            #{transactionId},
            #{paymentAmount},
            #{actualPrice},
            #{paymentResult}
        )
    </insert>

</mapper>
