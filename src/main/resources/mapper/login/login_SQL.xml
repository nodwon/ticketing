<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
============================================================
Project   : 관제 티켓 (Ticketing System)
FileName  : login_SQL.xml

Developer : 심재학 (feature/batman)
Created   : 2026.05.25
Modified  : 2026.05.25

Description :
  - 로그인 관련 MyBatis Mapper
  - 테이블: members
============================================================
-->
<mapper namespace="login">

    <!--
        로그인 처리
        - 입력: MEMBER_ID(=이메일), MEMBER_PASSWD(=비밀번호)
        - 출력: MEMBER_ID, MEMBER_NO, MEMBER_NAME, MEMBER_EMAIL, MEMBER_PASSWD, MEMBER_DELETE
        - 비밀번호는 자바에서 .equals() 비교 (Controller 로직 유지)
    -->
    <select id="loginAction" parameterType="hashMap" resultType="hashMap">
        SELECT
            email         AS MEMBER_ID,
            member_id     AS MEMBER_NO,
            name          AS MEMBER_NAME,
            email         AS MEMBER_EMAIL,
            password_hash AS MEMBER_PASSWD,
            '0'           AS MEMBER_DELETE,
			role AS MEMBER_GRADE
        FROM members
        WHERE email = #{MEMBER_ID}
    </select>

    <!-- 회원 이름 조회 (마이페이지 등) -->
    <select id="selectName" parameterType="hashMap" resultType="hashMap">
        SELECT
            email     AS MEMBER_ID,
            member_id AS MEMBER_NO,
            name      AS MEMBER_NAME,
            email     AS MEMBER_EMAIL
        FROM members
        WHERE email = #{MEMBER_ID}
    </select>

    <!--
        아이디 찾기 (이름 + 이메일 기반)
        - 입력: MEMBER_NAME, MEMBER_EMAIL
        - 출력: MEMBER_ID(=email), MEMBER_NAME
    -->
    <select id="selectFindId" parameterType="hashMap" resultType="hashMap">
        SELECT
            email AS MEMBER_ID,
            name  AS MEMBER_NAME
        FROM members
        WHERE name = #{MEMBER_NAME}
          AND email = #{MEMBER_EMAIL}
    </select>

    <!--
        이메일로 아이디 찾기
        - 입력: MEMBER_EMAIL, MEMBER_NAME
    -->
    <select id="selectFindId2" parameterType="hashMap" resultType="hashMap">
        SELECT
            email AS MEMBER_ID,
            name  AS MEMBER_NAME
        FROM members
        WHERE email = #{MEMBER_EMAIL}
          AND name = #{MEMBER_NAME}
    </select>

    <!--
        비밀번호 찾기 1단계: 회원 존재 확인
        - 입력: MEMBER_ID(=email)
        - 출력: email (String)
    -->
    <select id="selectFindPw" parameterType="hashMap" resultType="string">
        SELECT email
        FROM members
        WHERE email = #{MEMBER_ID}
    </select>

    <!--
        이메일로 비밀번호 찾기 2단계
        - 입력: MEMBER_EMAIL, MEMBER_NAME
    -->
    <select id="selectFindPw2" parameterType="hashMap" resultType="hashMap">
        SELECT
            email AS MEMBER_ID,
            name  AS MEMBER_NAME
        FROM members
        WHERE email = #{MEMBER_EMAIL}
          AND name  = #{MEMBER_NAME}
    </select>

    <!--
        임시 비밀번호로 변경
        - 입력: MEMBER_ID(=email), MEMBER_PASSWD(=새 비밀번호)
    -->
    <update id="updatePw" parameterType="hashMap">
        UPDATE members
           SET password_hash = #{MEMBER_PASSWD}
         WHERE email = #{MEMBER_ID}
    </update>

    <!--
        마지막 로그인 갱신
        ⚠️ members 테이블에 last_login 컬럼이 없어서 빈 동작으로 처리.
           DB 담당자에게 last_login 컬럼 추가 요청 시 아래 주석 해제.
        - 입력: Object (현재 자바 코드는 Object 타입)
    -->
    <update id="lastLogin" parameterType="java.lang.Object">
        UPDATE members
           SET role = role
         WHERE 1 = 0
    </update>

    <!--
        로그아웃 (현재는 회원 정보 조회. 로그아웃 이력 테이블 추가 시 INSERT로 확장)
        - 입력: MEMBER_ID(=email)
    -->
    <select id="logout" parameterType="hashMap" resultType="hashMap">
        SELECT
            email     AS MEMBER_ID,
            member_id AS MEMBER_NO,
            name      AS MEMBER_NAME
        FROM members
        WHERE email = #{MEMBER_ID}
    </select>

</mapper>