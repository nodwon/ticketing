<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    ============================================================
    Project    : 관제 티켓 (Ticketing System)
    FileName   : Goods_SQL.xml
    Namespace  : concert
    Developer  : 주재현 (feature/jjh)
    Created    : 2026.05.22
    Modified   : 2026.05.25
    Description: 공연 목록/상세/검색 매퍼
                 - CLOB → String 자동 변환 (resultMap + jdbcType)
                 - 대소문자 무관 검색 (UPPER)
    ============================================================
-->
<mapper namespace="concert">

    <!-- ============================================================ -->
    <!-- ★ CLOB 처리 핵심: resultMap 으로 String 매핑                 -->
    <!--   이걸 안 쓰면 description 이 oracle.sql.CLOB@xxxx 로 표시됨 -->
    <!-- ============================================================ -->
    <resultMap id="concertMap" type="java.util.HashMap">
        <id     property="concertId"  column="CONCERT_ID"  jdbcType="NUMERIC"/>
        <result property="title"      column="TITLE"       jdbcType="VARCHAR"/>
        <result property="artist"     column="ARTIST"      jdbcType="VARCHAR"/>
        <result property="venue"      column="VENUE"       jdbcType="VARCHAR"/>
        <result property="description" column="DESCRIPTION" jdbcType="CLOB" javaType="java.lang.String"/>
        <result property="thumbnail"  column="THUMBNAIL"   jdbcType="VARCHAR"/>
        <result property="status"     column="STATUS"      jdbcType="VARCHAR"/>
    </resultMap>

    <resultMap id="postMap" type="java.util.HashMap">
        <id     property="postId"     column="POST_ID"     jdbcType="NUMERIC"/>
        <result property="memberId"   column="MEMBER_ID"   jdbcType="NUMERIC"/>
        <result property="memberName" column="MEMBER_NAME" jdbcType="VARCHAR"/>
        <result property="postType"   column="POST_TYPE"   jdbcType="VARCHAR"/>
        <result property="title"      column="TITLE"       jdbcType="VARCHAR"/>
        <result property="content"    column="CONTENT"     jdbcType="CLOB" javaType="java.lang.String"/>
        <result property="createdAt"  column="CREATED_AT"  jdbcType="VARCHAR"/>
    </resultMap>

    <resultMap id="qnaMap" type="java.util.HashMap">
        <id     property="qnaId"      column="QNA_ID"      jdbcType="NUMERIC"/>
        <result property="memberId"   column="MEMBER_ID"   jdbcType="NUMERIC"/>
        <result property="memberName" column="MEMBER_NAME" jdbcType="VARCHAR"/>
        <result property="title"      column="TITLE"       jdbcType="VARCHAR"/>
        <result property="content"    column="CONTENT"     jdbcType="CLOB" javaType="java.lang.String"/>
        <result property="createdAt"  column="CREATED_AT"  jdbcType="VARCHAR"/>
    </resultMap>


    <!-- ============================================================ -->
    <!-- 공연 목록 조회 (검색/정렬)                                   -->
    <!-- 대소문자 무관: UPPER(컬럼) LIKE UPPER('%키워드%')             -->
    <!-- orderBy: newest(기본) / title / artist                       -->
    <!-- ============================================================ -->
    <select id="selectConcertList" parameterType="map" resultMap="concertMap">
        SELECT
              concert_id
            , title
            , artist
            , venue
            , description
            , thumbnail
            , status
        FROM concerts
        <where>
            <if test="keyword != null and keyword != ''">
                AND (UPPER(title)  LIKE '%' || UPPER(#{keyword}) || '%'
                  OR UPPER(artist) LIKE '%' || UPPER(#{keyword}) || '%'
                  OR UPPER(venue)  LIKE '%' || UPPER(#{keyword}) || '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        <choose>
            <when test='orderBy == "title"'>  ORDER BY title  ASC, concert_id DESC</when>
            <when test='orderBy == "artist"'> ORDER BY artist ASC, concert_id DESC</when>
            <otherwise>                       ORDER BY concert_id DESC</otherwise>
        </choose>
    </select>

    <!-- ============================================================ -->
    <!-- 공연 상세                                                    -->
    <!-- ============================================================ -->
    <select id="selectConcertDetail" parameterType="long" resultMap="concertMap">
        SELECT
              concert_id
            , title
            , artist
            , venue
            , description
            , thumbnail
            , status
        FROM concerts
        WHERE concert_id = #{concertId}
    </select>

    <!-- ============================================================ -->
    <!-- 통합 검색 (제목/아티스트/공연장 - 대소문자 무관)             -->
    <!-- ============================================================ -->
    <select id="searchConcerts" parameterType="string" resultMap="concertMap">
        SELECT
              concert_id
            , title
            , artist
            , venue
            , description
            , thumbnail
            , status
        FROM concerts
        <where>
            <if test="_parameter != null and _parameter != ''">
                  UPPER(title)  LIKE '%' || UPPER(#{keyword}) || '%'
               OR UPPER(artist) LIKE '%' || UPPER(#{keyword}) || '%'
               OR UPPER(venue)  LIKE '%' || UPPER(#{keyword}) || '%'
            </if>
        </where>
        ORDER BY concert_id DESC
    </select>

    <!-- ============================================================ -->
    <!-- 후기 목록 (posts.post_type='REVIEW')                         -->
    <!-- ============================================================ -->
    <select id="selectReviewPosts" resultMap="postMap">
        SELECT
              p.post_id
            , p.member_id
            , m.name AS member_name
            , p.post_type
            , p.title
            , p.content
            , TO_CHAR(p.created_at, 'YYYY-MM-DD HH24:MI') AS created_at
        FROM posts p
        LEFT JOIN members m ON p.member_id = m.member_id
        WHERE p.post_type = 'REVIEW'
        ORDER BY p.post_id DESC
    </select>

    <!-- ============================================================ -->
    <!-- Q&A 목록                                                     -->
    <!-- ============================================================ -->
    <select id="selectQnaPosts" resultMap="qnaMap">
        SELECT
              q.qna_id
            , q.member_id
            , m.name AS member_name
            , q.title
            , q.content
            , TO_CHAR(q.created_at, 'YYYY-MM-DD HH24:MI') AS created_at
        FROM qna_posts q
        LEFT JOIN members m ON q.member_id = m.member_id
        ORDER BY q.qna_id DESC
    </select>

</mapper>
